# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Served to the dashboard so it can perform a login. Grants no data access:
# anon is denied every table by the policies in supabase/migrations/0005_rls.sql.
SUPABASE_ANON_KEY=

# Absolute base URL, used to build manage links in emails.
PUBLIC_BASE_URL=http://localhost:3000

# --- Not yet read by any code. Listed so the shape is settled before the
# --- integrations land; see the roadmap in README.md.

# Google Calendar (milestone 2). Read brief 6.3-6.6 before touching these:
# publish the OAuth app to Production or refresh tokens die every 7 days, and
# stay on calendar.events + calendar.freebusy to avoid the CASA assessment.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Transactional email (milestone 2). A single SMTP account does not survive
# multi-tenancy — use a provider with a product-owned sending domain.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@example.com

# Stripe (milestone 3).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Shared secret for the reminder cron endpoint.
CRON_SECRET=
