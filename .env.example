# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Served to the dashboard so it can perform a login. Grants no data access:
# anon is denied every table by the policies in supabase/migrations/0005_rls.sql.
SUPABASE_ANON_KEY=

# Same two values, again, with the NEXT_PUBLIC_ prefix. Next.js only ships
# env vars into the browser bundle when they carry that prefix — the admin
# login page and dashboard run in the browser and need their own copy to sign
# a user in and hold their session. Safe to expose: it's the same anon key
# above, which already grants nothing on its own.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Absolute base URL. Used for manage links and OAuth callback redirects.
PUBLIC_BASE_URL=http://localhost:3000

# Encrypts stored Google refresh tokens and signs OAuth state. Required.
# Must be at least 32 characters: openssl rand -base64 32
# Rotating it invalidates every stored calendar connection — tenants would all
# have to reconnect — so treat it as permanent once tenants exist.
APP_SECRET=

# Google Calendar. Read brief 6.3-6.6 before touching these: publish the OAuth
# app to Production or refresh tokens die every 7 days, and stay on
# calendar.events + calendar.freebusy to avoid the CASA assessment.
# GOOGLE_REDIRECT_URI must match the Authorised redirect URI registered in the
# Cloud Console exactly, including scheme, port and trailing path.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# AI-assisted intake design (Intake's Questions tab — see src/lib/ai).
# Without this set, POST /api/admin/[slug]/ai/intake-draft returns a clear
# "not configured" error rather than a silent empty draft; every other
# admin feature works fine with this unset.
ANTHROPIC_API_KEY=

# Transactional email (booking confirmed/rescheduled/cancelled, the owner
# notification — see src/lib/email). Plain SMTP, not a provider-specific
# API — whatever mailbox a host hands you (Hostinger or otherwise) drops
# straight into these four. Without SMTP_HOST set, email logs to the server
# console instead of sending — loudly, not silently — and every other
# feature, including bookings themselves, works fine either way; nothing
# gates on an email actually going out.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# The address every email sends from. Tenant identity is the display name
# and Reply-To only (a single mailbox sending as hundreds of businesses is
# a spoofing problem) — see src/lib/email/provider.ts.
EMAIL_FROM_ADDRESS=no-reply@example.com

# --- Not yet read by any code. Listed so the shape is settled before the
# --- integrations land; see the roadmap in README.md.

# Stripe (milestone 3).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Shared secret for the reminder cron endpoint.
CRON_SECRET=
